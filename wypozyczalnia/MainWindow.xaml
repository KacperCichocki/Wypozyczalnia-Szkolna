<Window x:Class="wypozyczalnia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wypożyczalnia sprzętu szkolnego"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>

    <!-- Nagłówki kolumn -->
    <Style x:Key="ModernColumnHeader"
           TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

    <!-- Wiersze listy -->
    <Style x:Key="ModernHistoryItem"
           TargetType="{x:Type ListViewItem}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#F1F5F9"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="0">
                        <GridViewRowPresenter
                            Content="{TemplateBinding Content}"
                            Columns="{Binding
                                RelativeSource={RelativeSource
                                    AncestorType={x:Type ListView}},
                                Path=View.Columns}"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder"
                                    Property="Background"
                                    Value="#F8FAFC"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder"
                                    Property="Background"
                                    Value="#EFF6FF"/>
                            <Setter Property="Foreground"
                                    Value="#1D4ED8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cała lista -->
    <Style x:Key="ModernHistoryList"
           TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Auto"/>
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource ModernHistoryItem}"/>
    </Style>

    <!-- Lista sprzętu -->
    <Style x:Key="ModernEquipmentList"
    TargetType="{x:Type ListView}"
    BasedOn="{StaticResource ModernHistoryList}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    </Window.Resources>
	<Grid Margin="15">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="200"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Menu boczne -->
		<Border Grid.Column="0" Padding="12" Margin="0,0,12,0">
			<StackPanel>
				<TextBlock Text="Wypożyczalnia"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="5,10,5,25"/>
				<Button Content="Wypożycz sprzęt" Margin="0,4" Padding="10" Click="WypozyczSprzet_Click"/>
				<Button Content="Oddaj sprzęt" Margin="0,4" Padding="10" Click="Button_Click_1"/>
				<Button x:Name="btnHistoria" Content="Historia wypożyczeń" Margin="0,4" Padding="10" Click="HistoriaWpozyczen_Click"/>
			</StackPanel>
		</Border>

		<!-- Panel główny -->
		<Border Grid.Column="1" Padding="20">
			<DockPanel>
				<!-- Górny panel (nagłówek, wyszukiwanie, przycisk akcji) -->
				<StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
					<TextBlock x:Name="txtNaglowek"
                               Text="Dostępny sprzęt"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>
					<TextBox x:Name="txtSzukaj"
                             Height="35"
                             FontSize="14"
                             Padding="8"
                             VerticalContentAlignment="Center"
                             ToolTip="Wpisz nazwę sprzętu"
                             TextChanged="txtSzukaj_TextChanged"/>
					<Button x:Name="btnAkcja" Content="Wypożycz wybrany sprzęt"
                            Height="40"
                            Margin="0,12,0,0"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold" Click="Button_Click"/>
				</StackPanel>

				<!-- Obszar wyświetlania (Przełączany widok) -->
				<Grid>
					<!-- Lista sprzętu -->
                    <ListView x:Name="listaSprzetu"
          Grid.Row="2"
          Style="{StaticResource ModernEquipmentList}"
          SelectionMode="Single">

                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ModernColumnHeader}">

                                <!-- Zaznaczanie wszystkich -->
                                <GridViewColumn Width="45">
                                    <GridViewColumn.Header>
                                        <CheckBox x:Name="chkZaznaczWszystkie"
                              ToolTip="Zaznacz wszystkie dostępne przedmioty"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Checked="chkZaznaczWszystkie_Checked"
                              Unchecked="chkZaznaczWszystkie_Unchecked"/>
                                    </GridViewColumn.Header>

                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CzyZaznaczony, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="NAZWA SPRZĘTU"
                            DisplayMemberBinding="{Binding Nazwa}"
                            Width="190"/>

                                <GridViewColumn Header="KATEGORIA"
                            DisplayMemberBinding="{Binding Kategoria}"
                            Width="140"/>

                                <GridViewColumn Header="NR SERYJNY"
                            DisplayMemberBinding="{Binding NumerSeryjny}"
                            Width="150"/>

                                <GridViewColumn Header="STAN TECHNICZNY"
                            DisplayMemberBinding="{Binding StanTechniczny}"
                            Width="130"/>

                                <GridViewColumn Header="STATUS"
                            DisplayMemberBinding="{Binding Status}"
                            Width="120"/>

                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Lista historii (domyślnie ukryta) -->
                    <ListView x:Name="listaHistorii"
                          Style="{StaticResource ModernHistoryList}"
                          Visibility="Collapsed"
                          FontSize="13">

                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ModernColumnHeader}">

                                <GridViewColumn Header="SPRZĘT"
                            DisplayMemberBinding="{Binding NazwaSprzetu}"
                            Width="190"/>

                                <GridViewColumn Header="AKCJA"
                            DisplayMemberBinding="{Binding TypAkcji}"
                            Width="120"/>

                                <GridViewColumn Header="OSOBA"
                            DisplayMemberBinding="{Binding Osoba}"
                            Width="160"/>

                                <GridViewColumn Header="NR SERYJNY"
                            DisplayMemberBinding="{Binding NumerSeryjny}"
                            Width="140"/>

                                <GridViewColumn Header="DATA OPERACJI"
                            DisplayMemberBinding="{Binding Data,
                                StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                            Width="150"/>

                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
			</DockPanel>
		</Border>
	</Grid>
</Window>