<Window x:Class="wypozyczalnia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wypożyczalnia sprzętu szkolnego"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="12"
                Margin="0,0,12,0">

            <StackPanel>
                <TextBlock Text="Wypożyczalnia"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="5,10,5,25"/>

                <Button Content="Strona główna" Margin="0,4" Padding="10"/>
                <Button Content="Wypożycz sprzęt" Margin="0,4" Padding="10"/>
                <Button Content="Moje wypożyczenia" Margin="0,4" Padding="10"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Padding="20">

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <TextBlock Text="Dostępny sprzęt"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBox x:Name="txtSzukaj"
                             Height="35"
                             FontSize="14"
                             Padding="8"
                             VerticalContentAlignment="Center"
                             ToolTip="Wpisz nazwę sprzętu"/>

                    <Button Content="Wypożycz wybrany sprzęt"
                            Height="40"
                            Margin="0,12,0,0"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"/>
                </StackPanel>

                <ListView x:Name="listaSprzetu"
                          FontSize="15">
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>