<Window x:Class="wypozyczalnia.WypozyczenieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wypożyczenie sprzętu"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Podaj imię i nazwisko osoby wypożyczającej:"
                   Margin="0,0,0,10"
                   FontSize="14"/>
        <TextBox x:Name="txtOsoba"
                 MinWidth="340"
                 Height="32"
                 Padding="6"
                 VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Anuluj"
                    Width="90"
                    Margin="0,0,10,0"
                    Padding="8"
                    Click="Anuluj_Click"/>
            <Button Content="Zatwierdź"
                    Width="90"
                    Padding="8"
                    IsDefault="True"
                    Click="Zatwierdz_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
